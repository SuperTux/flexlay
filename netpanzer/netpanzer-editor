#!/bin/sh

# Prefer the Ruby that matches the SWIG extension.  Override with
# RUBY=/path/to/ruby if needed (e.g. when running under Nix).
RUBY="${RUBY:-ruby}"

LD_LIBRARY_PATH=$LD_LIBRARY_PATH:../lib:../ruby
export LD_LIBRARY_PATH

RUBYLIB=$RUBYLIB:../ruby
export RUBYLIB

exec "$RUBY" -w ./netpanzer.rb "$@"

# EOF #
